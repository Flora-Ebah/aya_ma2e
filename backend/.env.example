# =========================================================
# Configuration backend MA2E
# Copier vers .env et remplir avec les vraies valeurs.
# JAMAIS commiter .env (déjà dans .gitignore).
# =========================================================

# --- Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Redis
REDIS_URL=redis://HOST:PORT/0

# --- MinIO (stockage des pièces d'identité, chiffré au repos)
MINIO_ENDPOINT=HOST:PORT
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true   # true en prod, false en local

# --- Auth (JWT)
JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- LEGACY (gardé pour compat — production utilise Azure ci-dessous)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MINDEE_API_KEY=
MINDEE_MODEL_ID=

# --- Azure OpenAI — Chat conversationnel (déploiement type gpt-5.4-mini)
# Endpoint format : https://<resource>.cognitiveservices.azure.com/
# Utilise la Responses API ; pas besoin du suffixe `/openai/responses` ici
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Azure AI Vision — OCR CNI (Read API spécialisée)
# Endpoint format : https://<resource>.cognitiveservices.azure.com/
AZURE_AI_VISION_ENDPOINT=https://YOUR_VISION_RESOURCE.cognitiveservices.azure.com/
AZURE_AI_VISION_API_KEY=

# --- WhatsApp Meta Cloud API
WHATSAPP_VERIFY_TOKEN=ma2e_verify_token_change_me
# F-04 — App Secret Meta (Facebook Developers → App → Settings → Basique).
# Vérifie X-Hub-Signature-256 sur chaque webhook entrant. En prod, si vide
# → tous les webhooks WhatsApp sont refusés avec 503.
WHATSAPP_APP_SECRET=

# --- WhatsApp per-tenant (utilisé par le seed pour peupler la DB)
WHATSAPP_PHONE_ID_MA2E=
WHATSAPP_ACCESS_TOKEN_MA2E=
WABA_ID_MA2E=

# --- Telegram (facultatif — canal actuellement inutilisé chez MA2E)
TELEGRAM_TOKEN_MA2E=

# --- F-04 — Canal web anonyme : allowlist d'origines HTTP autorisées à poster
#     sur /webhooks/web/*. CSV, sans slash final. En prod, si vide → refus 503.
# Exemple : https://ma2e.swedencentral.cloudapp.azure.com,https://ma2e.ci
WEB_CHANNEL_ALLOWED_ORIGINS=

# --- F-12 — Piste d'audit strictement immuable, sans exception de rôle.
#     Break-glass exceptionnel pour super_admin en dev/staging uniquement,
#     REFUSÉ en production quelle que soit sa valeur. Ne PAS activer hors
#     incident majeur.
AUDIT_BREAK_GLASS_ENABLED=false

# --- Azure OpenAI Embeddings (RAG, text-embedding-3-small, 1536 dims)
AZURE_OPENAI_EMBEDDING=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2023-05-15
AZURE_OPENAI_API_KEY_EMBEDDING=

# --- SMTP (MailHog en dev/staging, vrai SMTP en prod : Resend/Brevo/SES)
SMTP_HOST=localhost
SMTP_PORT=51025          # MailHog local : 51025 ; Resend : 465 ; etc.
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false       # true en prod avec un vrai provider
SMTP_FROM_EMAIL=no-reply@ma2e.ci
SMTP_FROM_NAME=MA2E Notifications

# --- App
APP_ENV=production
APP_BASE_URL=https://api.ma2e.ci
PUBLIC_WEBHOOK_URL=https://api.ma2e.ci
